{
  "name": "pi-intercom",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "types.ts",
    "config.ts",
    "reply-tracker.ts",
    "session-targets.ts",
    "broker/**/*.ts",
    "ui/**/*.ts",
    "skills/**/*",
    "scripts/"
  ],
  "scripts": {
    "test": "tsx --test broker/paths.test.ts broker/spawn.test.ts session-targets.test.ts reply-tracker.test.ts intercom.integration.test.ts test/inline-message.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke:real-pi": "node scripts/real-pi-smoke.mjs"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.8 <1",
    "@earendil-works/pi-tui": ">=0.79.8 <1"
  },
  "dependencies": {
    "tsx": "^4.20.0",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.9.3"
  }
}
